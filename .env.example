# Medisend — Online Ραντεβού (Hapio Booking Flow)
# Αντιγράψτε σε .env.local (τοπικά) ή ορίστε ως Environment Variables στο Vercel.

# ΔΗΜΟΣΙΟ Hapio token (client-side — εκτίθεται στον browser).
# Πρέπει να είναι ΞΕΧΩΡΙΣΤΟ token με ΜΟΝΟ αυτά τα δικαιώματα:
#   booking:create, location:view, service:view, resource:view,
#   resource_service:view, bookable_slot:view
# ΜΗΝ χρησιμοποιείτε το admin HAPIO_API_KEY του backend.
VITE_HAPIO_API_TOKEN=

# Προαιρετικό — default είναι το eu-central-1
# VITE_HAPIO_BASE_URL=https://eu-central-1.hapio.net/v1

# ── Email επιβεβαίωσης (Brevo) ─────────────────────────────
# Server-side μόνο (δεν εκτίθενται στον browser).
# Το Hapio δεν στέλνει email· τα στέλνει το /api/notify μέσω Brevo.
# API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Επαληθευμένος αποστολέας στο Brevo (Senders → verify this email)
SENDER_EMAIL=
SENDER_NAME=Medisend

# Email κλινικής για ειδοποίηση νέου ραντεβού (default: SENDER_EMAIL)
CLINIC_EMAIL=

# ── SMS (Brevo transactional SMS) ──
# Όνομα αποστολέα, max 11 χαρακτήρες (alphanumeric)
SMS_SENDER=Medisend
# "false" για απενεργοποίηση SMS
SMS_ENABLED=true
# Προαιρετικό: SMS ειδοποίηση στην κλινική (E.164, π.χ. +306900000000)
CLINIC_PHONE=

# ── Medisend API (για attribution προσωπικών links) ──
# Το booking app ενημερώνει το Medisend ποιος χρήστης «έκλεισε» το ραντεβού.
# π.χ. http://localhost:3001/api  ή  https://medilab-api.onrender.com/api
VITE_MEDILAB_API_URL=
